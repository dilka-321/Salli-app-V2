{
  "name": "salli-money-manager",
  "version": "1.9.0",
  "private": true,
  "description": "Salli \u2014 personal money manager (Android build with Capacitor)",
  "scripts": {
    "android:add": "npx cap add android",
    "android:sync": "node scripts/copy-vendor.js && npx cap sync android",
    "android:open": "npx cap open android",
    "android:apk": "node scripts/copy-vendor.js && npx cap sync android && cd android && ./gradlew assembleDebug",
    "vendor": "node scripts/copy-vendor.js"
  },
  "dependencies": {
    "@capacitor/android": "6.2.0",
    "@capacitor/app": "6.0.2",
    "@capacitor/core": "6.2.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/share": "6.0.3",
    "@capgo/capacitor-native-biometric": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "6.2.0"
  },
  "optionalDependencies": {
    "@fontsource/dm-sans": "^5.0.0",
    "@fontsource/inter": "^5.0.0",
    "@fontsource/lora": "^5.0.0",
    "@fontsource/manrope": "^5.0.0",
    "@fontsource/noto-sans-sinhala": "^5.0.0",
    "@fontsource/noto-sans-tamil": "^5.0.0",
    "@fontsource/nunito": "^5.0.0",
    "@fontsource/poppins": "^5.0.0",
    "@fontsource/roboto": "^5.0.0",
    "@supabase/supabase-js": "^2.45.4"
  }
}
